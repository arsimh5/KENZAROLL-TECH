# Copy this file to .env.local and replace values with the real email server.
# For Gmail, use an app password, not the normal account password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@example.com
SMTP_PASS=your-smtp-password
CONTACT_FROM_EMAIL=info@example.com
CONTACT_TO_EMAIL=info@example.com
